// Schéma TheraSim — modèle de données de la spec V2 (drills + carte multi-référentiels).
// Tout est "conscient du référentiel" (framework_id partout) : Option A de la spec (§2.3).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Configuration applicative (clé/valeur) ------------------------------
// Sert notamment au choix du modèle LLM par usage : clés 'model.patient',
// 'model.evaluateur', 'model.generation'. Éditable depuis la console super-admin.
model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_config")
}

// --- Multi-tenant & marque blanche ---------------------------------------

// Une plateforme cliente. Le tenant "public" (type=public) = site B2C ouvert.
// Les tenants de type whitelabel = plateformes clientes brandées (B2B).
model Tenant {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique // 'public', 'institut-x'… (sert au routage / sous-domaine)
  nom          String
  type         String   @default("whitelabel") // 'public' | 'whitelabel'
  statut       String   @default("actif") // 'actif' | 'suspendu'
  // Branding (marque blanche)
  brandName    String?  @map("brand_name")
  logoUrl      String?  @map("logo_url")
  colorPrimary String?  @map("color_primary")
  // Opt-in (plateformes B2B) : autorise les MEMBRES à acheter individuellement
  // (référentiels à l'unité + abonnements) au-delà du catalogue de la plateforme.
  // Le catalogue de la plateforme reste débloqué d'office pour eux.
  allowIndividualOffers Boolean @default(false) @map("allow_individual_offers")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("tenants")
}

// --- Identité (spec §3) ---------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String   @unique
  firstName    String?  @map("first_name") // prénom (inscription B2C) : accueil personnalisé
  role         String   @default("learner") // 'super_admin' | 'tenant_admin' | 'learner'
  passwordHash String?  @map("password_hash") // mot de passe optionnel (sinon lien magique)
  consentAt    DateTime? @map("consent_at") // horodatage du consentement RGPD à l'inscription
  // Portefeuille de crédits IA (mini-scènes / entretiens). Drills QCM = gratuits.
  // `credits` = portefeuille PERSISTANT : crédits achetés en packs (vrai argent) +
  // crédits gratuits (bienvenue / plancher mensuel). Jamais remis à zéro.
  credits            Int       @default(0)
  // `planCredits` = allocation de l'abonnement/essai pour la période EN COURS.
  // Non cumulatif : remis à la valeur du forfait à chaque nouvelle période (le
  // reliquat non consommé est perdu), et remis à 0 à la fin de l'accès. Séparé de
  // `credits` pour ne JAMAIS confisquer un crédit acheté. Débit : planCredits d'abord.
  planCredits        Int       @default(0) @map("plan_credits")
  // null = jamais initialisé (déclenche le pack de bienvenue au 1er accès) ;
  // sinon = date du dernier rafraîchissement (sert à la recharge mensuelle).
  creditsRefreshedAt DateTime? @map("credits_refreshed_at")
  // Client Stripe (créé au premier achat/abonnement). Un seul par utilisateur.
  stripeCustomerId   String?   @map("stripe_customer_id")
  // --- Programme d'affiliation (Ambassadeurs) ---
  referralCode      String?   @unique @map("referral_code") // code public de l'ambassadeur (généré à l'activation)
  referredByUserId  String?   @map("referred_by_user_id") @db.Uuid // parrain DIRECT (niveau 1), figé à l'inscription
  ambassadorAt      DateTime? @map("ambassador_at") // date d'activation du statut ambassadeur (null = pas activé)
  ambassadorTermsAt DateTime? @map("ambassador_terms_at") // consentement CGU affiliation
  // --- Bêta fermée (invitations) ---
  isBetaTester Boolean @default(false) @map("is_beta_tester") // segmentation stats/emails
  betaCohort   String? @map("beta_cohort") // ex. 'beta-2026-01'
  // Relance témoignage (promoteurs NPS 8-10) : posé à l'envoi de la sollicitation,
  // déclenchée à la soumission du bilan. Empêche un second envoi.
  testimonialInviteAt DateTime? @map("testimonial_invite_at")
  // Entretien simulé (N3) « découverte » : le compte gratuit y a droit UNE fois dans
  // sa vie, gratuitement en crédits. Ce marqueur est À VIE — jamais réinitialisé par la
  // recharge mensuelle. null = pas encore utilisé.
  discoveryInterviewUsedAt DateTime? @map("discovery_interview_used_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([referredByUserId])
  @@map("users")
}

// Journal d'audit : évènements non dérivables des autres tables
// (connexions, invitations, changements de rôle). Alimente le journal d'activité.
model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  email     String // acteur (dénormalisé pour l'affichage/filtre)
  action    String // 'login' | 'invite' | 'role_change' | 'member_removed'
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([createdAt])
  @@map("audit_events")
}

// Mesure de l'entonnoir d'acquisition (growth). First-party, sans donnée
// personnelle : `visitorId` est un identifiant anonyme (cookie ts_vid), jamais
// une IP ni un user-agent. `userId` est rempli dès qu'on connaît l'utilisateur
// (permet de relier un parcours anonyme au compte créé).
model FunnelEvent {
  id        String   @id @default(uuid()) @db.Uuid
  visitorId String   @map("visitor_id")
  userId    String?  @map("user_id") @db.Uuid
  // 'landing_view' | 'demo_start' | 'signup_start' | 'signup_complete'
  //  | 'activation' | 'checkout_start' | 'purchase'
  event     String
  path      String?
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([event, createdAt])
  @@index([visitorId])
  @@index([userId])
  @@map("funnel_events")
}

// Journal des mouvements de crédits (traçabilité : bienvenue, recharge, consommation, octroi).
model CreditLedger {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  delta        Int // +octroi / -consommation
  balanceAfter Int      @map("balance_after")
  reason       String // 'welcome' | 'monthly' | 'consume_miniscene' | 'consume_simulation' | 'refund' | 'admin_grant' | 'purchase' | 'subscription_renewal' | 'plan_upgrade_topup' | 'plan_expired'
  meta         Json?
  createdAt    DateTime @default(now()) @map("created_at")

  // --- Idempotence STRUCTURELLE des octrois liés à un abonnement ---
  // Le doublon est refusé par la base, pas par la coordination de deux chemins de
  // code : peu importe lequel du webhook `invoice.paid` ou du rechargement paresseux
  // se déclenche en premier, ou qu'un événement Stripe soit rejoué.
  // `periodIndex` est RELATIF à l'ancre de l'abonnement (jamais le mois calendaire).
  // Les deux colonnes restent NULL pour tous les autres mouvements (welcome, monthly,
  // purchase, consume_*) : en Postgres, NULL n'entre jamais en conflit dans une
  // contrainte unique -> ajout purement additif, aucune ligne existante impactée.
  stripeSubscriptionId String? @map("stripe_subscription_id")
  periodIndex          Int?    @map("period_index")

  @@unique([stripeSubscriptionId, reason, periodIndex])
  @@index([userId])
  @@map("credit_ledger")
}

// --- Paiements (Stripe) ----------------------------------------------------

// Forfait d'abonnement mensuel, défini par le super-admin (aucun prix en dur
// côté code — voir /admin/facturation). Un abonnement actif accorde
// `monthlyCredits` à chaque renouvellement, EN PLUS de la recharge mensuelle
// gratuite (deux mécanismes indépendants, voir credits.ts).
model SubscriptionPlan {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @unique
  label          String
  // Allocation mensuelle de crédits de mise en situation. null = « sans compter »
  // (aucun décompte, aucun plafond de crédits — l'anti-abus est un garde-fou séparé).
  // Ne JAMAIS coder l'illimité par un grand nombre.
  monthlyCredits Int?     @map("monthly_credits")
  // Nombre de SPÉCIALITÉS que l'abonné peut choisir. Le socle ne compte jamais dans ce
  // quota. null = toutes les spécialités. Les choix sont conservés ; un échange (swap)
  // est possible une fois par période sur les forfaits intermédiaires.
  frameworkQuota Int?     @map("framework_quota")
  priceEurCents  Int      @map("price_eur_cents") // affichage seul — Stripe fait foi pour la facturation
  stripePriceId  String?  @map("stripe_price_id") // Price ID récurrent (Dashboard Stripe)
  active         Boolean  @default(true)
  ordre          Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("subscription_plans")
}

// Abonnement actif d'un utilisateur (au plus un par utilisateur).
model UserSubscription {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @unique @map("user_id") @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  planId               String    @map("plan_id") @db.Uuid
  stripeSubscriptionId String    @unique @map("stripe_subscription_id")
  status               String // 'active' | 'trialing' | 'past_due' | 'canceled' | 'incomplete'
  currentPeriodEnd     DateTime? @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  // Ancre de facturation (Stripe `subscription.start_date`) : sert à calculer un
  // periodIndex DÉTERMINISTE et relatif à l'abonnement (jamais le mois calendaire),
  // partagé par le chemin paresseux et le chemin webhook. Voir src/lib/credits.ts.
  periodAnchorAt       DateTime? @map("period_anchor_at")
  // Fin de période d'essai (null hors essai). Alimenté depuis Stripe `trial_end`.
  trialEndsAt          DateTime? @map("trial_ends_at")
  // Dernier `periodIndex` où un ÉCHANGE de spécialité a été effectué. Sert à limiter le
  // swap à une fois par période de facturation (même clé que la recharge). null = jamais.
  specialtySwapPeriodIndex Int? @map("specialty_swap_period_index")
  // Suivi d'envoi des emails de cycle d'essai (anti-doublon sur rejeu/cron).
  midTrialEmailAt      DateTime? @map("mid_trial_email_at")
  trialEndEmailAt      DateTime? @map("trial_end_email_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("user_subscriptions")
}

// Offre d'achat à l'unité d'un référentiel (paiement unique, accès à vie).
model FrameworkOffer {
  frameworkId   String  @id @map("framework_id")
  priceEurCents Int     @map("price_eur_cents") // affichage seul — Stripe fait foi
  stripePriceId String? @map("stripe_price_id") // Price ID one-time (Dashboard Stripe)
  active        Boolean @default(true)

  @@map("framework_offers")
}

// Accès individuel à un référentiel. Ne concerne que le tenant public (B2C) —
// les tenants B2B passent par les packs de contenu au niveau plateforme.
// 'purchase'/'admin' = accès à vie ; 'subscription_choice' = choix consommé sur
// le quota du forfait, valide uniquement tant que l'abonnement est actif
// (conservé en base : se réactive si l'abonné revient).
model UserFrameworkAccess {
  userId      String   @map("user_id") @db.Uuid
  frameworkId String   @map("framework_id")
  source      String // 'purchase' | 'admin' | 'subscription_choice'
  createdAt   DateTime @default(now()) @map("created_at")

  @@id([userId, frameworkId])
  @@map("user_framework_access")
}

// Idempotence des webhooks Stripe : un event ne doit être traité qu'une fois
// (Stripe garantit "at least once", jamais "exactly once").
model StripeEvent {
  id        String   @id // evt_...
  type      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("stripe_events")
}

// --- Programme d'affiliation (Ambassadeurs) --------------------------------

// Journal des commissions d'affiliation. Miroir de CreditLedger (même logique
// ledger : chaque ligne = un mouvement, balanceAfter = solde après ce mouvement).
// Limite légale : niveau 2 MAXIMUM (voir User.referredByUserId, non chaîné plus
// loin) — au-delà, le dispositif serait un système pyramidal (interdit).
model CommissionLedger {
  id              String   @id @default(uuid()) @db.Uuid
  beneficiaryId   String   @map("beneficiary_id") @db.Uuid // l'ambassadeur qui touche
  delta           Int // + gain / - paiement, en CENTIMES
  balanceAfter    Int      @map("balance_after") // solde après, en centimes
  // 'commission_sub_t1' | 'commission_sub_t2' | 'commission_school' | 'payout' | 'clawback' | 'adjustment'
  reason          String
  tier            Int? // 1 ou 2 pour les commissions d'abonnement
  sourceUserId    String?  @map("source_user_id") @db.Uuid // le filleul dont l'abonnement génère la commission
  stripeInvoiceId String?  @map("stripe_invoice_id") // clé d'idempotence
  payoutRequestId String?  @map("payout_request_id") @db.Uuid
  meta            Json?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([beneficiaryId, createdAt])
  // Idempotence : une même facture ne peut pas créer deux fois la même commission
  // pour le même bénéficiaire au même palier.
  @@unique([beneficiaryId, stripeInvoiceId, tier])
  @@map("commission_ledger")
}

// Demande de paiement de commission par un ambassadeur.
model PayoutRequest {
  id             String    @id @default(uuid()) @db.Uuid
  ambassadorId   String    @map("ambassador_id") @db.Uuid
  amountCents    Int       @map("amount_cents") // montant demandé (= solde au moment de la demande)
  status         String    @default("pending") // 'pending' | 'invoice_received' | 'paid' | 'rejected'
  invoiceEmailAt DateTime? @map("invoice_email_at") // quand l'ambassadeur signale avoir envoyé la facture
  paidAt         DateTime? @map("paid_at")
  note           String? // note interne admin (réf. virement, etc.)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([ambassadorId])
  @@map("payout_requests")
}

// Jeton de connexion par lien magique (usage unique, expirable).
model AuthToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  email     String
  tenantId  String    @map("tenant_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("auth_tokens")
}

// --- Catalogue, packs & droits d'accès (entitlements) --------------------

// Un pack = regroupement de référentiels, composé par le super-admin.
model Pack {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  nom         String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("packs")
}

model PackFramework {
  packId      String @map("pack_id") @db.Uuid
  frameworkId String @map("framework_id")

  @@id([packId, frameworkId])
  @@map("pack_frameworks")
}

// Pack accordé à un tenant.
model TenantPack {
  tenantId String @map("tenant_id") @db.Uuid
  packId   String @map("pack_id") @db.Uuid

  @@id([tenantId, packId])
  @@map("tenant_packs")
}

// Ajustement fin : ajoute ou retire un référentiel pour un tenant donné.
model TenantFrameworkOverride {
  tenantId    String @map("tenant_id") @db.Uuid
  frameworkId String @map("framework_id")
  mode        String // 'add' | 'remove'

  @@id([tenantId, frameworkId])
  @@map("tenant_framework_overrides")
}

// --- Socle référentiels (spec §2.5) --------------------------------------

model Framework {
  id          String  @id // 'em', 'act', 'anamnese', 'burnout'
  // Slug PUBLIC, distinct de l'id technique : porte le SEO (/domaines/[slug]).
  slug        String  @unique
  nom         String
  type        String // 'approche' | 'transversale' | 'situation'
  gridId      String  @map("grid_id")
  // `description` reste INTERNE. `introPublique` = texte d'accroche public (200-300 mots),
  // affiché sur la page domaine (repli sur description si absent).
  description   String?
  introPublique String? @map("intro_publique")
  // Métadonnées publiques optionnelles (texte libre, affichées seulement si renseignées).
  auteurs         String?
  cadreReference  String? @map("cadre_reference")
  statut      String  @default("brouillon") // 'brouillon' | 'calibre' | 'publie'
  // Suivi de fraîcheur (SEO : lastmod). @default(now()) pour peupler les lignes existantes
  // au `db push` ; @updatedAt le rafraîchit à chaque enrichissement.
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  // Nature commerciale : 'socle' = accessible à TOUT compte (gratuit compris), hors
  // quota ; 'specialite' = compté dans le quota du forfait. String + union TS + Zod
  // (convention du dépôt, pas d'enum natif). Défaut prudent : 'specialite'.
  nature      String  @default("specialite") // 'socle' | 'specialite'
  // Palier requis (réservé usage FUTUR, inexploité au lancement) : permettra un jour
  // de réserver un référentiel au palier haut sans refonte. 'standard' | 'premium'.
  tier        String  @default("standard")

  @@map("frameworks")
}

model CompetencyGrid {
  id  String @id // 'em-v1'
  nom String

  @@map("competency_grids")
}

// Catégorie de compétences à l'intérieur d'une grille (ex: "Posture et esprit").
model Category {
  id     String @id @default(uuid()) @db.Uuid
  gridId String @map("grid_id")
  code   String // 'posture'
  nom    String
  ordre  Int    @default(0)

  @@unique([gridId, code])
  @@map("categories")
}

// Compétence + ancrages 1/3/5 (utilisés par l'évaluateur mono-compétence).
model Competency {
  id           String  @id @default(uuid()) @db.Uuid
  gridId       String  @map("grid_id")
  categoryCode String  @map("category_code")
  code         String // 'reflets', 'questions_ouvertes', 'empathie'
  nom          String
  description  String?
  ancrage1     String? @map("ancrage_1")
  ancrage3     String? @map("ancrage_3")
  ancrage5     String? @map("ancrage_5")
  ordre        Int     @default(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([gridId, code])
  @@map("competencies")
}

// Cas / persona dont les drills sont tirés (hérité du MVP, + framework_id).
model Scenario {
  id          String  @id // 'EM-ALC-01'
  frameworkId String  @map("framework_id")
  titre       String
  contexte    String?
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("scenarios")
}

// --- Mode entraînement (spec §4.2) ---------------------------------------

model Drill {
  id                   String  @id // 'DRL-QO-01'
  frameworkId          String  @map("framework_id")
  competencyId         String  @map("competency_id") // code de la grille du référentiel
  scenarioContext      String? @map("scenario_context") // réf. Scenario.id, nullable
  difficulty           Int // 1..3
  mode                 String // 'reconnaissance' | 'production'
  rappelTheorique      String  @map("rappel_theorique")
  stimulus             String
  options              Json? // [{text, is_best, score, feedback}] si reconnaissance
  patientReactionSiBon String? @map("patient_reaction_si_bon")
  modeleReponse        String  @map("modele_reponse")

  @@index([frameworkId, competencyId])
  @@map("drills")
}

// Un essai unitaire (drill OU compétence dérivée d'une simulation).
model Attempt {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  frameworkId  String   @map("framework_id")
  competencyId String   @map("competency_id")
  source       String // 'drill' | 'simulation'
  sourceRef    String?  @map("source_ref") // drill_id ou session_id
  score        Float // normalisé 0..1 (spec §5.1)
  raw          Json? // feedback, citation, etc.
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, frameworkId, competencyId])
  @@map("attempts")
}

// --- Simulation complète (N3) ---------------------------------------------

// Une session d'entretien simulé (patient incarné par un LLM, débrief sommatif).
model SimSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  frameworkId String    @map("framework_id")
  scenarioId  String    @map("scenario_id")
  kind        String    @default("simulation") // 'simulation' (N3) | 'miniscene' (N2)
  maxTurns    Int?      @map("max_turns") // borne de tours pour les mini-scènes (N2)
  focus       Json? // mini-scène : codes des 2 compétences ciblées
  statut      String    @default("en_cours") // 'en_cours' | 'terminee'
  debrief     Json? // { scores:[{competency_id,note,justification,evidence}], narrative, moments:[{quote,comment}] }
  selfAssessment Json? @map("self_assessment") // { [competency_code]: note 1..5 } — auto-évaluation avant débrief
  createdAt   DateTime  @default(now()) @map("created_at")
  endedAt     DateTime? @map("ended_at")

  @@index([userId, frameworkId])
  @@map("sim_sessions")
}

model SimMessage {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  role      String // 'patient' | 'apprenant'
  content   String
  turn      Int
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("sim_messages")
}

// --- Formations & modules (structure pédagogique du formateur) ------------

// Une formation = un programme, composé de modules.
model Formation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  createdBy   String   @map("created_by") @db.Uuid
  titre       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("formations")
}

// Un module couvre un ou plusieurs référentiels, chacun avec ses compétences.
// items = [{ frameworkId, competencies: [codes] }]
model FormationModule {
  id          String @id @default(uuid()) @db.Uuid
  formationId String @map("formation_id") @db.Uuid
  nom         String
  items       Json
  ordre       Int    @default(0)

  @@index([formationId])
  @@map("formation_modules")
}

// --- Sessions live (évaluation animée par un formateur) -------------------

model LiveSession {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  createdBy    String    @map("created_by") @db.Uuid
  titre        String
  pairs        Json? // [{ frameworkId, code }] : compétences testées (multi-référentiel)
  frameworkId  String?   @map("framework_id") // legacy / référentiel principal (affichage)
  competencies Json? // legacy : codes des compétences
  drillIds     Json // snapshot des exercices (identiques pour tous les participants)
  mode         String // 'apprentissage' | 'evaluation'
  durationMin  Int       @map("duration_min")
  // cycle de vie : brouillon -> ouverte (sas d'attente) -> en_cours (chrono) -> fermee
  statut       String    @default("brouillon")
  opensAt      DateTime? @map("opens_at")
  startedAt    DateTime? @map("started_at")
  closesAt     DateTime? @map("closes_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("live_sessions")
}

model LiveParticipant {
  id         String    @id @default(uuid()) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  prenom     String
  nom        String
  joinedAt   DateTime  @default(now()) @map("joined_at")
  finishedAt DateTime? @map("finished_at")

  @@index([sessionId])
  @@map("live_participants")
}

model LiveAnswer {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  drillId       String   @map("drill_id")
  frameworkId   String?  @map("framework_id")
  competencyId  String   @map("competency_id")
  optionIndex   Int      @map("option_index")
  score         Float
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([participantId])
  @@map("live_answers")
}

// --- Supervision formateur -------------------------------------------------

// Note laissée par un formateur/admin sur la progression d'un apprenant,
// éventuellement rattachée à une mise en situation précise (sourceRef = SimSession.id).
model SupervisorNote {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  learnerId String   @map("learner_id") @db.Uuid
  sessionId String?  @map("session_id") @db.Uuid // SimSession.id, si liée à un entretien précis
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, learnerId])
  @@map("supervisor_notes")
}

// État de maîtrise agrégé par utilisateur × référentiel × compétence (spec §5.2).
// La PK inclut framework_id : aucune fusion possible entre référentiels.
model UserCompetencyState {
  userId        String    @map("user_id") @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  frameworkId   String    @map("framework_id")
  competencyId  String    @map("competency_id")
  mastery       Float? // 0..1, NULL si jamais pratiqué
  attempts      Int       @default(0)
  lastPracticed DateTime? @map("last_practiced")

  @@id([userId, frameworkId, competencyId])
  @@map("user_competency_state")
}

// --- Support client ---------------------------------------------------------
// Un ticket est OUVERT ou CLOS, sans état intermédiaire. Qui doit répondre ne se
// déclare pas : cela se lit à l'auteur du dernier message.

model SupportTicket {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  type    String // 'bug' | 'idea'
  subject String
  status  String @default("open") // 'open' | 'closed'

  // Contexte technique relevé automatiquement à l'envoi (page, navigateur, version
  // de l'app, forfait, statut d'abonnement, solde). Ne contient JAMAIS de contenu de
  // simulation ni de donnée clinique.
  context Json?

  // Dénormalisé : la liste admin trie par activité et repère « en attente de moi »
  // sans une requête par ligne.
  lastMessageAt   DateTime @default(now()) @map("last_message_at")
  lastMessageFrom String   @default("client") @map("last_message_from") // 'client' | 'admin'

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, lastMessageAt])
  @@index([status, lastMessageAt])
  @@map("support_tickets")
}

model SupportMessage {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorRole String   @map("author_role") // 'client' | 'admin'
  authorId   String?  @map("author_id") @db.Uuid
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// Limitation de débit générique (une ligne = une tentative horodatée).
// En base plutôt qu'en mémoire : sur Vercel, chaque instance de fonction a sa
// propre mémoire, un compteur en RAM ne limiterait donc rien.
model RateLimitHit {
  id        String   @id @default(uuid()) @db.Uuid
  key       String // ex. 'beta-claim:ip:1.2.3.4' | 'beta-claim:user:<uuid>'
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("rate_limit_hits")
}

// --- Bêta fermée : invitations à usage unique ------------------------------
// Un code envoyé par email ouvre un abonnement d'essai (plan Intensif, 90 j, sans
// carte bancaire). Pas de code promo public : l'accès est nominatif et révocable.

model BetaInvite {
  id     String  @id @default(uuid()) @db.Uuid
  // Code long (24 car. base32 sans ambiguïté) : un code court serait brute-forçable.
  code   String  @unique
  email  String? // destinataire prévu — indicatif, jamais une contrainte à la réclamation
  note   String? // prénom, profession, cohorte…
  cohort String  @default("beta-2026-01")

  // 'PENDING' | 'CLAIMED' | 'REVOKED' | 'EXPIRED' — String et non enum natif :
  // convention du schéma (aucun enum ici), et un enum Postgres se retire mal via
  // `db:push`. Le typage vient du union TS + zod dans src/lib/beta-status.ts.
  status          String    @default("PENDING")
  claimedByUserId String?   @map("claimed_by_user_id") @db.Uuid
  claimedAt       DateTime? @map("claimed_at")
  // Expiration du CODE d'invitation (défaut : +30 j), à ne pas confondre avec la
  // fin de l'essai de 90 jours qui, elle, court à partir de la réclamation.
  expiresAt       DateTime         @map("expires_at")

  stripeSubscriptionId String? @map("stripe_subscription_id")

  // Dernier envoi de l'email d'invitation (null = jamais envoyée). Permet de
  // distinguer « code créé » de « code envoyé », et de relancer en connaissance de cause.
  emailSentAt DateTime? @map("email_sent_at")

  // Relance J+2 « sans activité » (envoyée ~48 h après l'invitation, si aucun exercice
  // n'a été lancé). Marqueur posé à l'unique traitement de l'invitation par le cron :
  // garantit un envoi au plus, qu'on ait relancé ou décidé de ne pas le faire (activité détectée).
  nudgeEmailAt DateTime? @map("nudge_email_at")

  // Relance « impression à chaud » : envoyée après 3 mises en situation terminées, ou
  // au plus tard à J+7 de l'activation (si un minimum d'activité). Posé uniquement à
  // l'envoi effectif (contrairement à nudgeEmailAt) : tant que le seuil n'est pas
  // atteint, l'invitation reste candidate les jours suivants.
  feedbackEmailAt DateTime? @map("feedback_email_at")

  // Relance « bilan » de fin de phase active : envoyée à J+21 de l'activation.
  // Marqueur posé à l'envoi (anti-doublon sur relance du cron).
  bilanEmailAt DateTime? @map("bilan_email_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([claimedByUserId])
  @@index([cohort])
  @@map("beta_invites")
}

// Réponses au questionnaire « impression à chaud » de la bêta (3 questions ouvertes),
// recueillies via /beta/feedback et relues en backoffice (/admin/beta/feedback).
model BetaFeedback {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  cohort    String?
  q1        String // ce qui a le plus surpris (en bien ou en mal)
  q2        String // moment d'hésitation / décrochage
  q3        String // feedback assez précis et crédible ?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId])
  @@map("beta_feedback")
}

// Bilan de fin de phase active (J+21) : 4 questions ouvertes + score de recommandation
// (NPS 0..10) et sa justification. Le NPS 8-10 déclenche la relance témoignage.
model BetaBilan {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  cohort    String?
  q1        String // ce que MELETA a réellement apporté
  q2        String // situation où l'app a paru la plus utile
  q3        String // ce qui reste peu crédible / frustrant / inutile
  q4        String // sentiment d'aisance accrue sur certaines compétences
  nps       Int // 0..10 : probabilité de recommander
  npsWhy    String   @map("nps_why") // pourquoi cette note
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId])
  @@index([nps])
  @@map("beta_bilan")
}

// Témoignage recueilli auprès d'un promoteur (NPS 8-10). Publié sur le site UNIQUEMENT
// après validation admin, selon le mode d'affichage choisi par l'auteur.
model Testimonial {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  beforeText  String   @map("before_text") // « Avant MELETA, je… »
  duringText  String   @map("during_text") // « En utilisant MELETA, j'ai… »
  afterText   String   @map("after_text") //  « Aujourd'hui, je… »
  // 'name_profession' | 'first_name' | 'anonymous' — choix d'affichage de l'auteur.
  displayMode String   @map("display_mode")
  firstName   String?  @map("first_name") // instantané, pour l'affichage public
  profession  String? // saisie facultative (mode 'name_profession')
  // 'pending' | 'published' | 'rejected' — publication après validation admin.
  status      String   @default("pending")
  // 'beta' (promoteur sollicité) | 'spontaneous' (avis laissé librement depuis le site).
  source      String   @default("beta")
  createdAt   DateTime @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([status, createdAt])
  @@index([userId])
  @@map("testimonials")
}
