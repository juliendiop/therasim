# Base de données PostgreSQL (Neon en prod, ou Postgres local en dev)
# Récupérer la chaîne sur https://console.neon.tech (Connection string, pooled)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret de signature des sessions (lien magique). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# URL de base de l'app (pour construire les liens magiques). En prod : l'URL Vercel.
APP_BASE_URL="http://localhost:3000"

# Mot de passe initial du super-admin, appliqué au `npm run db:seed`. À changer ensuite
# depuis Admin -> Mon compte. Laisser vide pour ne pas définir de mot de passe.
ADMIN_INITIAL_PASSWORD=""

# LLM (production drills, mini-scènes N2, simulateur N3).
# Deux fournisseurs possibles — le choix par usage se fait dans /admin/modeles.
# Mistral : clé sur https://console.mistral.ai
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"
# Claude (Anthropic) : clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Envoi des emails (liens de connexion, offres). Clé sur https://resend.com
# EMAIL_FROM doit utiliser un domaine vérifié dans Resend (ex. @meleta.app) pour
# pouvoir envoyer à n'importe qui. Sinon, repli sur onboarding@resend.dev (envoi
# limité à l'email du compte Resend).
RESEND_API_KEY=""
EMAIL_FROM="MELETA <noreply@meleta.app>"

# Paiements (Stripe) — packs de crédits + forfaits d'abonnement (/credits).
# Clé secrète (mode TEST d'abord) : https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# Secret de signature du webhook, obtenu APRÈS avoir enregistré l'endpoint
# https://<domaine>/api/stripe/webhook dans le Dashboard Stripe (voir 00_DEMARRAGE.md
# pour la liste des événements à sélectionner).
STRIPE_WEBHOOK_SECRET=""

# --- Bêta fermée -----------------------------------------------------------
# Code de réduction Stripe réservé aux bêta-testeurs, proposé dans l'email de fin
# d'essai. Laisser vide pour ne pas en proposer.
# Le forfait offert, lui, n'a PAS de variable d'environnement : il est résolu en base
# par sa clé ("intensif"), avec le Price ID administré dans /admin/facturation —
# une variable d'env dupliquerait cette source de vérité.
BETA_CONVERSION_COUPON=""

# Secret partagé protégeant les routes cron (Vercel envoie `Authorization: Bearer <secret>`).
# Sans lui, /api/cron/* refuse de s'exécuter plutôt que d'être déclenchable publiquement.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
