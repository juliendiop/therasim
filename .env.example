# Base de données PostgreSQL (Neon en prod, ou Postgres local en dev)
# Récupérer la chaîne sur https://console.neon.tech (Connection string, pooled)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret de signature des sessions (lien magique). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# URL de base de l'app (pour construire les liens magiques). En prod : l'URL Vercel.
APP_BASE_URL="http://localhost:3000"

# LLM évaluateur (mode "production" des drills + simulations). Optionnel en session 1
# (le mode "reconnaissance" ne l'utilise pas). Clé sur https://console.mistral.ai
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-large-latest"
